[
    {
        "name": "tag_form",
        "checkrule": "?HTML%TAG/form+%TAG/input|%TAG/textarea|%TAG/text",
        "fuzzers": [
            {
                "claster": "confidentiality",
                "name": "sqli"
            },
            {
                "claster": "integrity",
                "name": "big_str"
            }
        ],
        "data": {
            "url": "!HTML%TAG/form+%ATTRIBUTE/action",
            "data": "!HTML%TAG/form+%TAG/input*textarea*text+%ATTRIBUTE/name",
            "placeholder": "BODY",
            "headers": "Content-Type: application/x-www-form-urlencoded",
            "method": "!HTML%TAG/form+%ATTRIBUTE/method"
        }
    },
    {
        "name": "url_parameter",
        "checkrule": "?HTML%TAG/a+%ATTRIBUTE/href+%CONTAINS/'?'",
        "fuzzers": [
            {
                "claster": "confidentiality",
                "name": "sqli"
            },
            {
                "claster": "integrity",
                "name": "big_str"
            }
        ],
        "data": {
            "url": "!HTML%TAG/a+%ATTRIBUTE/href+%CONTAINS/'?'",
            "data": "!HTML%TAG/a+%ATTRIBUTE/href+%CONTAINS/'?'+%PARAMETER/*",
            "placeholder": "URL",
            "headers": "",
            "method": "GET"
        }
    },
    {
        "name": "header_content_type",
        "checkrule": "?HTTP%HEADER/content-type+%VALUE/json",
        "fuzzers": [
            {
                "claster": "integrity",
                "name": "false_content-type"
            }
        ],
        "data": {
            "url": "SELF",
            "data": "",
            "placeholder": "HEADER",
            "headers": "Content-Type",
            "method": "GET"
        }
    }
]
